# Public client configuration only. VITE_* values are embedded in the bundle.
VITE_APP_URL=/api
# Deprecated client key setting: leave empty. Shared keys must stay server-side.
VITE_AI_API_KEY=
VITE_AI_API_BASE=https://api.deepseek.com/v1
VITE_AI_API_MODEL=deepseek-chat
# Never put a shared provider secret in VITE_AI_API_KEY, including on Vercel.
