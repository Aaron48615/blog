---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection, render } from "astro:content";

export async function getStaticPaths() {
  const posts = await getCollection("posts");
  return posts.map((post) => ({
    params: { slug: post.data.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content, headings } = await render(post);

// Filter h2 and h3 for Table of Contents
const toc = headings.filter((h) => h.depth === 2 || h.depth === 3);

// Fetch other posts for "More Posts"
const allPosts = await getCollection("posts");
const morePosts = allPosts
  .filter((p) => p.data.slug !== post.data.slug)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 4);

const formattedDate = post.data.date.toLocaleDateString("zh-CN", {
  year: "numeric",
  month: "2-digit",
  day: "2-digit",
});
---

<BaseLayout
  title={`${post.data.title} | Aaron`}
  description={post.data.summary}
>
  <div class="article-layout animate-fade-in">
    <!-- Left Column: Table of Contents & More Posts (Chirpy Simplified Left Sticky Bar) -->
    <aside class="article-sidebar animate-fade-in delay-1">
      <a href="/posts" class="back-link">
        <svg
          width="16"
          height="16"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2.2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path d="m15 18-6-6 6-6"></path>
        </svg>
        <span>返回文章列表</span>
      </a>

      <!-- Table of Contents Card (Desktop) -->
      {
        toc.length > 0 && (
          <div class="sidebar-block toc-block desktop-only">
            <div class="block-header">
              <span class="block-icon">📑</span>
              <h2 class="block-title">本文目录</h2>
            </div>
            <nav class="toc-nav" aria-label="文章目录">
              <ul class="toc-list" id="desktop-toc-list">
                {toc.map((heading) => (
                  <li class={`toc-item depth-${heading.depth}`}>
                    <a
                      href={`#${heading.slug}`}
                      class="toc-link"
                      data-slug={heading.slug}
                    >
                      <span class="toc-bullet" />
                      <span class="toc-text">{heading.text}</span>
                    </a>
                  </li>
                ))}
              </ul>
            </nav>
          </div>
        )
      }

      <!-- More Posts Card (Desktop) -->
      {
        morePosts.length > 0 && (
          <div class="sidebar-block more-posts-block desktop-only">
            <div class="block-header">
              <span class="block-icon">📚</span>
              <h2 class="block-title">更多文章</h2>
            </div>
            <ul class="more-posts-list">
              {morePosts.map((otherPost) => (
                <li class="more-post-item">
                  <a
                    href={`/posts/${otherPost.data.slug}`}
                    class="more-post-link"
                  >
                    <span class="more-post-title">{otherPost.data.title}</span>
                    <time class="more-post-date">
                      {otherPost.data.date.toLocaleDateString("zh-CN", {
                        month: "2-digit",
                        day: "2-digit",
                      })}
                    </time>
                  </a>
                </li>
              ))}
            </ul>
          </div>
        )
      }
    </aside>

    <!-- Right Column: Main Article Body -->
    <main class="article-main animate-fade-in delay-2">
      <article class="article-content">
        <!-- Article Header -->
        <header class="article-header">
          <div class="header-meta">
            <time datetime={post.data.date.toISOString()} class="article-date">
              {formattedDate}
            </time>
            {
              post.data.tags.length > 0 && (
                <div class="article-tags">
                  {post.data.tags.map((tag) => (
                    <span class="tag-pill">{tag}</span>
                  ))}
                </div>
              )
            }
          </div>

          <h1 class="article-title">{post.data.title}</h1>

          {
            post.data.summary && (
              <div class="article-lead">
                <p>{post.data.summary}</p>
              </div>
            )
          }
        </header>

        <!-- Mobile TOC Accordion -->
        {
          toc.length > 0 && (
            <details class="mobile-toc-details mobile-only">
              <summary class="mobile-toc-summary">
                <div class="summary-left">
                  <span class="block-icon">📑</span>
                  <span>本文目录 ({toc.length})</span>
                </div>
                <span class="summary-arrow">&darr;</span>
              </summary>
              <nav class="toc-nav mobile-toc-nav" aria-label="移动端文章目录">
                <ul class="toc-list">
                  {toc.map((heading) => (
                    <li class={`toc-item depth-${heading.depth}`}>
                      <a href={`#${heading.slug}`} class="toc-link">
                        <span class="toc-bullet" />
                        <span class="toc-text">{heading.text}</span>
                      </a>
                    </li>
                  ))}
                </ul>
              </nav>
            </details>
          )
        }

        <!-- Rendered Article Markdown Body -->
        <div class="article-body">
          <Content />
        </div>

        <!-- Article Footer / Navigation -->
        <footer class="article-footer">
          <div class="footer-notice">
            <p>感谢阅读。欢迎在 GitHub 探讨与交流。</p>
          </div>
          <div class="footer-actions">
            <a href="/posts" class="btn btn-secondary"> &larr; 返回所有文章 </a>
            <a
              href="https://github.com/Aaron48615"
              target="_blank"
              rel="noopener noreferrer"
              class="btn btn-primary"
            >
              关注 GitHub
            </a>
          </div>
        </footer>
      </article>

      <!-- Mobile Only More Posts -->
      {
        morePosts.length > 0 && (
          <section class="sidebar-block more-posts-block mobile-only mobile-more-posts">
            <div class="block-header">
              <span class="block-icon">📚</span>
              <h2 class="block-title">更多文章</h2>
            </div>
            <ul class="more-posts-list">
              {morePosts.map((otherPost) => (
                <li class="more-post-item">
                  <a
                    href={`/posts/${otherPost.data.slug}`}
                    class="more-post-link"
                  >
                    <span class="more-post-title">{otherPost.data.title}</span>
                    <time class="more-post-date">
                      {otherPost.data.date.toLocaleDateString("zh-CN", {
                        month: "2-digit",
                        day: "2-digit",
                      })}
                    </time>
                  </a>
                </li>
              ))}
            </ul>
          </section>
        )
      }
    </main>
  </div>
</BaseLayout>

<script>
  function setupTocScrollSpy() {
    const tocLinks = Array.from(
      document.querySelectorAll<HTMLAnchorElement>(
        "#desktop-toc-list .toc-link",
      ),
    );
    if (tocLinks.length === 0) return;

    const slugs = tocLinks
      .map((link) => link.getAttribute("data-slug"))
      .filter(Boolean) as string[];
    const headingElements = slugs
      .map((slug) => document.getElementById(slug))
      .filter((el): el is HTMLElement => el !== null);

    if (headingElements.length === 0) return;

    let activeSlug = "";

    function onScroll() {
      const targetOffset = 130;
      let currentSlug = "";

      for (const el of headingElements) {
        const top = el.getBoundingClientRect().top;
        if (top <= targetOffset) {
          currentSlug = el.id;
        } else {
          break;
        }
      }

      if (!currentSlug && headingElements.length > 0) {
        currentSlug = headingElements[0].id;
      }

      if (currentSlug !== activeSlug) {
        activeSlug = currentSlug;
        tocLinks.forEach((link) => {
          if (link.getAttribute("data-slug") === activeSlug) {
            link.classList.add("is-active");
          } else {
            link.classList.remove("is-active");
          }
        });
      }
    }

    window.addEventListener("scroll", onScroll, { passive: true });
    onScroll();
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", setupTocScrollSpy);
  } else {
    setupTocScrollSpy();
  }
</script>

<style>
  .article-layout {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.5rem;
    padding: 0.5rem 0 3.5rem;
  }

  @media (min-width: 900px) {
    .article-layout {
      grid-template-columns: 280px 1fr;
      gap: 3.5rem;
      align-items: start;
    }
  }

  /* ==========================================================================
     Left Sidebar (TOC & More Posts - Chirpy Style)
     ========================================================================== */
  .article-sidebar {
    position: relative;
  }

  @media (min-width: 900px) {
    .article-sidebar {
      position: sticky;
      top: 5.5rem;
      display: flex;
      flex-direction: column;
      gap: 1.5rem;
    }
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--color-text-forest);
    transition: all 0.2s ease;
    margin-bottom: 0.5rem;
  }

  .back-link:hover {
    color: var(--color-accent-sage);
    transform: translateX(-3px);
  }

  .sidebar-block {
    padding: 1.6rem;
    border-radius: var(--radius-md);
    background: var(--color-bg-surface);
    border: 1px solid var(--color-border-subtle);
    box-shadow: var(--shadow-sm);
  }

  .block-header {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 1rem;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid var(--color-border-subtle);
  }

  .block-icon {
    font-size: 1rem;
  }

  .block-title {
    font-size: 0.95rem;
    font-weight: 750;
    letter-spacing: -0.01em;
    margin: 0;
    color: var(--color-text-forest);
  }

  /* TOC Styles */
  .toc-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .toc-item {
    font-size: 0.875rem;
    line-height: 1.45;
  }

  .toc-item.depth-3 {
    padding-left: 1rem;
    font-size: 0.825rem;
  }

  .toc-link {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--color-text-secondary);
    padding: 0.35rem 0.55rem;
    border-radius: var(--radius-sm);
    transition: all 0.2s var(--ease-out-spring);
  }

  .toc-bullet {
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: var(--color-text-dim);
    flex-shrink: 0;
    transition: all 0.2s ease;
  }

  .toc-link:hover {
    color: var(--color-accent-forest);
    background: var(--color-bg-subtle);
  }

  .toc-link:hover .toc-bullet {
    background: var(--color-accent-forest);
  }

  .toc-link.is-active {
    color: var(--color-accent-forest);
    font-weight: 700;
    background: var(--color-bg-subtle);
  }

  .toc-link.is-active .toc-bullet {
    background: var(--color-accent-emerald);
    transform: scale(1.6);
    box-shadow: 0 0 6px rgba(46, 133, 64, 0.5);
  }

  /* More Posts Sidebar List */
  .more-posts-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .more-post-item {
    font-size: 0.85rem;
  }

  .more-post-link {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.5rem;
    color: var(--color-text-secondary);
    font-weight: 500;
    transition: color 0.2s ease;
  }

  .more-post-link:hover {
    color: var(--color-accent-forest);
  }

  .more-post-title {
    flex: 1;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .more-post-date {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--color-text-muted);
    flex-shrink: 0;
  }

  /* ==========================================================================
     Right Column: Article Container & Typography
     ========================================================================== */
  .article-main {
    max-width: 100%;
    min-width: 0;
  }

  .article-content {
    background: var(--color-bg-surface);
    border: 1px solid var(--color-border-subtle);
    border-radius: var(--radius-lg);
    padding: 2.75rem 3rem;
    box-shadow: var(--shadow-sm);
  }

  .article-header {
    margin-bottom: 2.5rem;
    padding-bottom: 1.75rem;
    border-bottom: 1px solid var(--color-border-subtle);
  }

  .header-meta {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    margin-bottom: 1rem;
  }

  .article-date {
    font-family: var(--font-mono);
    font-size: 0.825rem;
    color: var(--color-text-muted);
    font-weight: 550;
  }

  .article-tags {
    display: flex;
    gap: 0.35rem;
  }

  .tag-pill {
    font-size: 0.725rem;
    font-family: var(--font-mono);
    padding: 0.15rem 0.55rem;
    border-radius: var(--radius-full);
    background: var(--color-bg-subtle);
    border: 1px solid var(--color-border-subtle);
    color: var(--color-text-forest);
    font-weight: 600;
  }

  .article-title {
    font-size: clamp(2rem, 4.5vw, 2.75rem);
    font-weight: 800;
    letter-spacing: -0.035em;
    line-height: 1.22;
    margin: 0 0 1.25rem;
    color: var(--color-text-primary);
  }

  .article-lead {
    padding: 1.1rem 1.35rem;
    border-radius: var(--radius-sm);
    background: var(--color-bg-subtle);
    border-left: 3px solid var(--color-accent-forest);
    font-size: 1.05rem;
    color: var(--color-text-forest);
    line-height: 1.75;
  }

  .article-lead p {
    margin: 0;
  }

  /* Mobile TOC Details */
  .mobile-toc-details {
    margin-bottom: 2rem;
    border-radius: var(--radius-md);
    background: var(--color-bg-subtle);
    border: 1px solid var(--color-border-medium);
    padding: 0.75rem 1rem;
  }

  .mobile-toc-summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-size: 0.9rem;
    font-weight: 650;
    cursor: pointer;
    color: var(--color-text-forest);
    list-style: none;
  }

  .mobile-toc-summary::-webkit-details-marker {
    display: none;
  }

  .summary-left {
    display: flex;
    align-items: center;
    gap: 0.45rem;
  }

  .mobile-toc-nav {
    margin-top: 0.85rem;
    padding-top: 0.75rem;
    border-top: 1px solid var(--color-border-subtle);
  }

  /* Markdown Content Typography */
  .article-body {
    font-size: 1.05rem;
    line-height: 1.85;
    color: var(--color-text-secondary);
  }

  .article-body :global(h2) {
    font-size: clamp(1.4rem, 3vw, 1.75rem);
    font-weight: 750;
    margin: 2.75rem 0 1rem;
    color: var(--color-text-forest);
    letter-spacing: -0.025em;
    scroll-margin-top: 5.5rem;
    position: relative;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid var(--color-border-subtle);
  }

  .article-body :global(h3) {
    font-size: clamp(1.2rem, 2.5vw, 1.35rem);
    font-weight: 700;
    margin: 2.25rem 0 0.85rem;
    color: var(--color-text-primary);
    letter-spacing: -0.015em;
    scroll-margin-top: 5.5rem;
  }

  .article-body :global(p) {
    margin: 0 0 1.4rem;
  }

  .article-body :global(strong) {
    color: var(--color-text-primary);
    font-weight: 650;
  }

  .article-body :global(ul),
  .article-body :global(ol) {
    margin: 0 0 1.5rem;
    padding-left: 1.5rem;
  }

  .article-body :global(li) {
    margin-bottom: 0.45rem;
  }

  .article-body :global(blockquote) {
    margin: 1.75rem 0;
    padding: 1rem 1.4rem;
    border-left: 3px solid var(--color-accent-forest);
    background: var(--color-bg-subtle);
    border-radius: 0 var(--radius-sm) var(--radius-sm) 0;
    color: var(--color-text-forest);
    font-style: italic;
  }

  .article-body :global(code) {
    font-family: var(--font-mono);
    font-size: 0.88em;
    padding: 0.2em 0.45em;
    border-radius: 4px;
    background: var(--color-bg-subtle);
    color: var(--color-accent-forest);
    border: 1px solid var(--color-border-subtle);
  }

  .article-body :global(pre) {
    padding: 1.4rem;
    border-radius: var(--radius-md);
    background: #1a281d !important;
    color: #f8faf6 !important;
    border: 1px solid rgba(255, 255, 255, 0.12);
    overflow-x: auto;
    margin: 1.75rem 0;
    box-shadow: 0 8px 24px -4px rgba(10, 20, 12, 0.35);
  }

  .article-body :global(pre code) {
    padding: 0;
    background: none;
    border: none;
    color: inherit;
    font-size: 0.9em;
  }

  .article-footer {
    margin-top: 3.5rem;
    padding-top: 2rem;
    border-top: 1px solid var(--color-border-subtle);
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .footer-notice {
    font-size: 0.875rem;
    color: var(--color-text-muted);
  }

  .footer-notice p {
    margin: 0;
  }

  .footer-actions {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 1rem;
  }

  /* Visibility Helpers */
  .desktop-only {
    display: block;
  }

  .mobile-only {
    display: none;
  }

  .mobile-more-posts {
    margin-top: 2rem;
  }

  @media (max-width: 899px) {
    .desktop-only {
      display: none !important;
    }

    .mobile-only {
      display: block !important;
    }

    .article-content {
      padding: 1.75rem 1.35rem;
    }
  }
</style>
