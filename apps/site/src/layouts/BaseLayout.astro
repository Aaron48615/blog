---
import "../styles/global.css";
import SiteMotion from "../components/SiteMotion.astro";
import BotanicalBranch from "../components/BotanicalBranch.astro";

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = "Aaron - 个人空间 · 前端工程、全栈探索与交互美学",
} = Astro.props;

const currentPath = Astro.url.pathname;
const navItems = [
  { href: "/", label: "首页" },
  { href: "/posts", label: "文章" },
  { href: "/projects", label: "项目" },
];
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    {
      currentPath === "/" && (
        <link
          rel="preload"
          href="/fonts/SmileySans-QuoteSubset.woff2"
          as="font"
          type="font/woff2"
          crossorigin="anonymous"
        />
      )
    }
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#F2EFE5" />
    <title>{title}</title>
    <style>
      .header-wrapper {
        position: sticky;
        top: 1rem;
        z-index: 50;
        display: flex;
        justify-content: center;
        padding: 0 1rem;
      }

      .site-header-pill {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1.5rem;
        padding: 0.45rem 0.65rem 0.45rem 1.15rem;
        border-radius: var(--radius-full);
        background: var(--color-bg-glass);
        border: 1px solid var(--color-border-medium);
        backdrop-filter: blur(18px);
        -webkit-backdrop-filter: blur(18px);
        box-shadow: 0 8px 24px -4px rgba(35, 52, 38, 0.08);
        width: 100%;
        max-width: 640px;
        transition: all 0.25s var(--ease-out-spring);
      }

      .site-header-pill:hover {
        border-color: var(--color-accent-sage);
        box-shadow: 0 12px 30px -4px rgba(35, 52, 38, 0.12);
      }

      .brand {
        display: flex;
        align-items: center;
        gap: 0.65rem;
        font-weight: 750;
        font-size: 1.05rem;
        letter-spacing: -0.025em;
        color: var(--color-text-forest);
      }

      .brand-avatar {
        width: 30px;
        height: 30px;
        border-radius: var(--radius-sm);
        object-fit: cover;
        display: block;
        border: 1px solid var(--color-border-medium);
        box-shadow: 0 2px 6px rgba(35, 52, 38, 0.12);
        transition: transform 0.25s var(--ease-out-spring);
      }

      .brand:hover .brand-avatar {
        transform: scale(1.08);
      }

      .brand-name {
        font-weight: 750;
        letter-spacing: -0.03em;
      }

      .nav-list {
        list-style: none;
        margin: 0;
        padding: 0.2rem;
        display: flex;
        gap: 0.2rem;
        background: rgba(35, 52, 38, 0.05);
        border-radius: var(--radius-full);
      }

      .nav-link {
        display: inline-block;
        padding: 0.35rem 0.95rem;
        border-radius: var(--radius-full);
        font-size: 0.85rem;
        font-weight: 600;
        color: var(--color-text-secondary);
        transition: all 0.2s var(--ease-out-spring);
      }

      .nav-link:hover {
        color: var(--color-text-primary);
        background: rgba(255, 255, 255, 0.6);
      }

      .nav-link[aria-current="page"] {
        color: #faf8f3;
        background: var(--color-accent-forest);
        box-shadow: 0 2px 8px rgba(35, 52, 38, 0.2);
      }

      .site-main {
        flex: 1;
        padding: 2.5rem 0 4.5rem;
        position: relative;
        z-index: 1;
      }

      .site-footer {
        border-top: 1px solid var(--color-border-subtle);
        background: var(--color-bg-subtle);
        padding: 2.5rem 0;
        color: var(--color-text-muted);
        font-size: 0.875rem;
        position: relative;
        z-index: 1;
      }

      .footer-inner {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: space-between;
        gap: 1.25rem;
        text-align: center;
      }

      @media (min-width: 640px) {
        .footer-inner {
          flex-direction: row;
          text-align: left;
        }
      }

      .footer-links {
        display: flex;
        align-items: center;
        gap: 1.5rem;
      }

      .footer-link {
        color: var(--color-text-secondary);
        font-weight: 500;
        transition: color 0.2s ease;
      }

      .footer-link:hover {
        color: var(--color-accent-forest);
      }
    </style>
  </head>
  <body>
    <BotanicalBranch side="left" />
    <BotanicalBranch side="right" />

    <!-- Floating Pill Header -->
    <div class="header-wrapper">
      <header class="site-header-pill">
        <a class="brand" href="/" aria-label="Aaron 个人主页">
          <img
            src="/avatar.jpg"
            alt="Aaron"
            class="brand-avatar"
            width="30"
            height="30"
            loading="eager"
            decoding="async"
          />
          <span class="brand-name">Aaron</span>
        </a>
        <nav aria-label="主导航">
          <ul class="nav-list">
            {
              navItems.map((item) => (
                <li>
                  <a
                    class="nav-link"
                    href={item.href}
                    aria-current={
                      item.href === "/"
                        ? currentPath === "/"
                          ? "page"
                          : undefined
                        : currentPath === item.href ||
                            currentPath.startsWith(item.href + "/")
                          ? "page"
                          : undefined
                    }
                  >
                    {item.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
      </header>
    </div>

    <main class="site-main">
      <div class="container">
        <slot />
      </div>
    </main>

    <footer class="site-footer">
      <div class="container footer-inner">
        <div class="footer-copy">
          © {new Date().getFullYear()} Aaron. Crafted with Astro & Vestris Aesthetic.
        </div>
        <div class="footer-links">
          <a class="footer-link" href="/">首页</a>
          <a class="footer-link" href="/posts">文章</a>
          <a class="footer-link" href="/projects">项目</a>
          <a
            class="footer-link"
            href="https://github.com/Aaron48615"
            target="_blank"
            rel="noopener noreferrer"
          >
            GitHub
          </a>
        </div>
      </div>
    </footer>
    <SiteMotion />
  </body>
</html>
