---
import BaseLayout from "../layouts/BaseLayout.astro";

const projects = [
  {
    name: "拾光集移动商城系统",
    stack: ["Vue 3", "JavaScript", "TypeScript", "Vant 4", "Vite", "Axios", "Sass", "PostCSS(pxtorem)", "CryptoJS", "DeepSeek 大模型"],
    description:
      "拾光集移动商城系统是一款面向 C 端消费者的移动电商应用。项目实现了用户注册登录、首页推荐、商品分类与搜索、商品详情等功能，并在功能页面接入大模型实现商品搜索联想和卖点生成。",
    previewLink: "https://github.com/Aaron48615/blog/tree/main/apps/project-2",
    repoLink: "https://github.com/Aaron48615/blog/tree/main/apps/project-2",
    accent: "var(--accent-indigo)",
  },
  {
    name: "云枢智慧城市数据平台",
    stack: ["React 19", "JavaScript", "TypeScript", "Vite", "React Router", "React Redux", "redux-persist", "ECharts", "Axios", "JWT", "Three.js", "高德地图 API"],
    description:
      "该平台是一套面向城市运营人员和数据分析人员的智慧城市数据可视化平台。实现了城市运行数据的集中展示，提供城市运行指标总览、交通拥堵排行、公共设施与城市事件分析的数据可视化。",
    previewLink: "https://project-1-jade-omega.vercel.app",
    repoLink: "https://github.com/Aaron48615/blog/tree/main/apps/project-1",
    accent: "var(--accent-teal)",
  },
];
---

<BaseLayout
  title="项目 | Aaron"
  description="Aaron 的前端与全栈工程项目展示。"
>
  <div class="projects-page">
    <header class="page-header">
      <h1 class="page-title">项目</h1>
      <p class="page-subtitle">代表性前端与全栈工程项目。</p>
    </header>

    <div class="projects-container">
      {
        projects.map((project) => (
          <article class="project-item" style={`--item-accent: ${project.accent}`}>
            <div class="project-header">
              <h2 class="project-name">{project.name}</h2>
            </div>
            <p class="project-description">{project.description}</p>
            <div class="project-footer">
              <div class="stack-tags">
                {project.stack.map((tech) => (
                  <span class="tech-tag">{tech}</span>
                ))}
              </div>
              <div class="project-buttons">
                <a
                  href={project.previewLink}
                  class="btn btn-primary"
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  在线预览
                </a>
                <a
                  href={project.repoLink}
                  class="btn btn-secondary"
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  查看仓库
                </a>
              </div>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</BaseLayout>

<style>
  .projects-page {
    padding: 1rem 0 2rem;
  }

  .page-header {
    margin-bottom: 2.5rem;
  }

  .page-title {
    font-size: clamp(2rem, 4.5vw, 2.8rem);
    margin-top: 1rem;
    margin-bottom: 0.75rem;
    letter-spacing: -0.03em;
  }

  .page-subtitle {
    font-size: 1.05rem;
    color: var(--text-secondary);
    margin: 0;
  }

  .projects-container {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .project-item {
    padding: 2rem;
    border-radius: var(--radius-md);
    background: var(--bg-card);
    border: 1px solid var(--border-subtle);
    position: relative;
    overflow: hidden;
  }

  .project-item::before {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    width: 3px;
    height: 100%;
    background: var(--item-accent);
    opacity: 0.7;
  }

  .project-header {
    margin-bottom: 1rem;
  }

  .project-name {
    font-size: 1.5rem;
    font-weight: 700;
    margin: 0;
  }

  .project-description {
    font-size: 0.975rem;
    color: var(--text-secondary);
    line-height: 1.65;
    margin-bottom: 1.5rem;
  }

  .project-footer {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    flex-wrap: wrap;
    gap: 1rem;
    padding-top: 1.25rem;
    border-top: 1px solid rgba(255, 255, 255, 0.05);
  }

  .stack-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
  }

  .tech-tag {
    font-size: 0.775rem;
    font-family: var(--font-mono);
    padding: 0.25rem 0.6rem;
    border-radius: var(--radius-sm);
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid var(--border-subtle);
    color: var(--text-secondary);
  }

  .project-buttons {
    display: flex;
    gap: 0.75rem;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.5rem 1rem;
    border-radius: var(--radius-sm);
    font-size: 0.85rem;
    font-weight: 600;
    text-decoration: none;
    transition: all 0.2s ease;
    white-space: nowrap;
  }

  .btn-primary {
    background: rgba(45, 212, 191, 0.12);
    border: 1px solid rgba(45, 212, 191, 0.3);
    color: var(--accent-teal);
  }

  .btn-primary:hover {
    background: rgba(45, 212, 191, 0.2);
    border-color: var(--accent-teal);
  }

  .btn-secondary {
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid var(--border-subtle);
    color: var(--text-secondary);
  }

  .btn-secondary:hover {
    background: rgba(255, 255, 255, 0.08);
    border-color: var(--border-medium);
    color: var(--text-primary);
  }
</style>
