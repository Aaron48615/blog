---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection, render } from "astro:content";

export async function getStaticPaths() {
  const posts = await getCollection("posts");
  return posts.map((post) => ({
    params: { slug: post.data.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const formattedDate = post.data.date.toLocaleDateString("zh-CN", {
  year: "numeric",
  month: "2-digit",
  day: "2-digit",
});
---

<BaseLayout
  title={`${post.data.title} | Aaron`}
  description={post.data.summary}
>
  <article class="post-page">
    <header class="post-header">
      <a href="/posts" class="back-link">&larr; 文章列表</a>
      <h1 class="post-title">{post.data.title}</h1>
      <div class="post-meta">
        <time datetime={post.data.date.toISOString()}>{formattedDate}</time>
        {post.data.tags.length > 0 && (
          <div class="post-tags">
            {post.data.tags.map((tag) => (
              <span class="tag">{tag}</span>
            ))}
          </div>
        )}
      </div>
    </header>
    <div class="post-body">
      <Content />
    </div>
  </article>
</BaseLayout>

<style>
  .post-page {
    padding: 1rem 0 3rem;
    max-width: 42rem;
  }

  .post-header {
    margin-bottom: 2.5rem;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid var(--border-subtle);
  }

  .back-link {
    display: inline-block;
    font-size: 0.875rem;
    color: var(--accent-teal);
    text-decoration: none;
    margin-bottom: 1rem;
    transition: opacity 0.2s ease;
  }

  .back-link:hover {
    opacity: 0.8;
  }

  .post-title {
    font-size: clamp(1.8rem, 4vw, 2.5rem);
    font-weight: 800;
    letter-spacing: -0.035em;
    margin: 0 0 0.75rem;
    line-height: 1.2;
  }

  .post-meta {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-size: 0.825rem;
    color: var(--text-muted);
  }

  .post-tags {
    display: flex;
    gap: 0.35rem;
  }

  .tag {
    font-size: 0.725rem;
    padding: 0.15rem 0.5rem;
    border-radius: var(--radius-full);
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid var(--border-subtle);
    color: var(--text-secondary);
  }

  .post-body {
    font-size: 1.05rem;
    line-height: 1.8;
    color: var(--text-secondary);
  }

  .post-body :global(h2) {
    font-size: 1.4rem;
    font-weight: 700;
    margin: 2.5rem 0 1rem;
    color: var(--text-primary);
  }

  .post-body :global(h3) {
    font-size: 1.15rem;
    font-weight: 600;
    margin: 2rem 0 0.75rem;
    color: var(--text-primary);
  }

  .post-body :global(p) {
    margin: 0 0 1.25rem;
  }

  .post-body :global(ul),
  .post-body :global(ol) {
    margin: 0 0 1.25rem;
    padding-left: 1.5rem;
  }

  .post-body :global(li) {
    margin-bottom: 0.35rem;
  }

  .post-body :global(code) {
    font-family: var(--font-mono);
    font-size: 0.9em;
    padding: 0.15em 0.4em;
    border-radius: 4px;
    background: rgba(255, 255, 255, 0.06);
  }

  .post-body :global(pre) {
    padding: 1.25rem;
    border-radius: var(--radius-md);
    background: rgba(15, 21, 35, 0.6);
    border: 1px solid var(--border-subtle);
    overflow-x: auto;
    margin: 0 0 1.5rem;
  }

  .post-body :global(pre code) {
    padding: 0;
    background: none;
  }

  .post-body :global(blockquote) {
    margin: 0 0 1.5rem;
    padding: 0.75rem 1.25rem;
    border-left: 3px solid var(--accent-teal);
    background: rgba(45, 212, 191, 0.04);
    border-radius: 0 var(--radius-sm) var(--radius-sm) 0;
    color: var(--text-secondary);
    font-style: italic;
  }
</style>
