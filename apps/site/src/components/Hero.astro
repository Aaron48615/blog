---
const quotes = [
  { quote: "无限进步。", author: "影视飓风" },
  { quote: "保持饥饿，保持愚蠢。", author: "史蒂夫·乔布斯" },
  { quote: "达人所之未达，探人所之未知。", author: "徐霞客" },
  { quote: "勇踏前人未至之境。", author: "《星际迷航》" },
  { quote: "生命不息，折腾不止。", author: "罗永浩" },
  { quote: "人类的特别之处，在于对未知的狂热。", author: "赫拉利" },
  { quote: "我没有特别的天赋，只是极其好奇。", author: "阿尔伯特·爱因斯坦" },
];
---

<section class="hero-container animate-fade-in" aria-label="首页主要内容">
  <!-- Centerpiece: Transparent Quotes Rotator (HOME-02: 4s stay, 1.2s crossfade) -->
  <div
    class="quote-wrapper"
    id="quote-carousel"
    aria-roledescription="carousel"
    aria-label="名人名言轮播"
  >
    <div class="quote-stage">
      {
        quotes.map((item, index) => (
          <div
            class={`quote-slide ${index === 0 ? "is-active" : ""}`}
            data-index={index}
            aria-hidden={index === 0 ? "false" : "true"}
          >
            <blockquote class="quote-text">“{item.quote}”</blockquote>
            <cite class="quote-author">—— {item.author}</cite>
          </div>
        ))
      }
    </div>
  </div>

  <!-- Self Introduction (HOME-03) -->
  <p class="hero-desc animate-fade-in delay-2">
    Hello，我是Aaron。一个计算机界的新人，正在探索互联网海洋中。欢迎访问我的网站。
  </p>

  <!-- CTA Action Buttons -->
  <div class="hero-actions animate-fade-in delay-3">
    <a href="/projects" class="btn btn-primary" aria-label="前往浏览项目作品">
      <span>浏览项目作品</span>
      <svg
        width="16"
        height="16"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2.2"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <path d="M5 12h14"></path>
        <path d="m12 5 7 7-7 7"></path>
      </svg>
    </a>
    <a href="/posts" class="btn btn-secondary" aria-label="前往阅读文章">
      <span>阅读文章</span>
      <svg
        width="15"
        height="15"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"></path>
        <path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"></path>
      </svg>
    </a>
  </div>
</section>

<script>
  function setupQuoteCarousel() {
    const root = document.getElementById("quote-carousel");
    if (!root) return;

    const slides = Array.from(
      root.querySelectorAll<HTMLElement>(".quote-slide"),
    );
    if (slides.length <= 1) return;

    let currentIndex = 0;
    let timer: number | null = null;
    const INTERVAL_MS = 4000; // 用户确认：停留 4 秒

    function goToSlide(nextIndex: number) {
      if (nextIndex === currentIndex) return;

      slides[currentIndex]?.classList.remove("is-active");
      slides[currentIndex]?.setAttribute("aria-hidden", "true");

      currentIndex = (nextIndex + slides.length) % slides.length;

      slides[currentIndex]?.classList.add("is-active");
      slides[currentIndex]?.setAttribute("aria-hidden", "false");
    }

    function startAutoPlay() {
      if (timer !== null) return;
      if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;
      timer = window.setInterval(() => {
        goToSlide(currentIndex + 1);
      }, INTERVAL_MS);
    }

    function stopAutoPlay() {
      if (timer !== null) {
        clearInterval(timer);
        timer = null;
      }
    }

    root.addEventListener("mouseenter", stopAutoPlay);
    root.addEventListener("mouseleave", startAutoPlay);
    root.addEventListener("focusin", stopAutoPlay);
    root.addEventListener("focusout", startAutoPlay);

    startAutoPlay();
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", setupQuoteCarousel);
  } else {
    setupQuoteCarousel();
  }
</script>

<style>
  .hero-container {
    width: 100%;
    max-width: 860px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 2.5rem 1rem 2rem;
  }

  /* ==========================================================================
     Quote Carousel Component (HOME-02: Transparent, No Box, Large Artistic Text)
     ========================================================================== */
  .quote-wrapper {
    width: 100%;
    margin-bottom: 2rem;
    position: relative;
    background: transparent;
    border: none;
    box-shadow: none;
  }

  .quote-stage {
    position: relative;
    min-height: 160px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .quote-slide {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    opacity: 0;
    pointer-events: none;
    transform: translateY(4px);
    transition:
      opacity 1.2s ease-in-out,
      transform 1.2s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .quote-slide.is-active {
    opacity: 1;
    pointer-events: auto;
    transform: translateY(0);
    position: relative;
  }

  .quote-text {
    font-family: var(--font-quote);
    font-size: clamp(2.1rem, 4.8vw, 3.4rem);
    font-weight: 700;
    line-height: 1.35;
    letter-spacing: 0.02em;
    color: var(--color-text-primary);
    margin: 0 0 0.85rem;
    padding: 0;
    border: none;
    background: transparent;
    font-style: normal;
    text-shadow: 0 1px 2px rgba(242, 239, 229, 0.8);
  }

  .quote-author {
    font-family: var(--font-sans);
    font-size: clamp(0.95rem, 1.6vw, 1.15rem);
    font-style: normal;
    font-weight: 500;
    color: var(--color-text-muted);
    letter-spacing: 0.04em;
  }

  /* ==========================================================================
     Self Introduction (HOME-03)
     ========================================================================== */
  .hero-desc {
    font-size: clamp(1.05rem, 2vw, 1.2rem);
    line-height: 1.8;
    color: var(--color-text-secondary);
    max-width: 48ch;
    margin: 0 0 2.5rem;
    font-weight: 450;
  }

  /* ==========================================================================
     CTA Actions
     ========================================================================== */
  .hero-actions {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: 1.25rem;
  }

  .hero-actions .btn {
    padding: 0.8rem 1.8rem;
    font-size: 0.95rem;
  }

  @media (max-width: 640px) {
    .hero-container {
      padding: 1.5rem 0.5rem 1.5rem;
    }

    .quote-stage {
      min-height: 180px;
    }

    .quote-wrapper {
      margin-bottom: 1.5rem;
    }

    .hero-desc {
      margin-bottom: 2rem;
      font-size: 1rem;
    }

    .hero-actions {
      width: 100%;
      flex-direction: column;
      gap: 0.85rem;
    }

    .hero-actions .btn {
      width: 100%;
      max-width: 320px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .quote-slide {
      transition: opacity 0.1s ease !important;
      transform: none !important;
    }
  }
</style>
