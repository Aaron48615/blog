---
const quotes = [
  { quote: "无限进步。", author: "影视飓风" },
  { quote: "保持饥饿，保持愚蠢。", author: "史蒂夫·乔布斯" },
  { quote: "达人所之未达，探人所之未知。", author: "徐霞客" },
  { quote: "勇踏前人未至之境。", author: "《星际迷航》" },
  { quote: "生命不息，折腾不止。", author: "罗永浩" },
  { quote: "人类的特别之处，在于对未知的狂热。", author: "赫拉利" },
  { quote: "我没有特别的天赋，只是极其好奇。", author: "阿尔伯特·爱因斯坦" },
];
---

<!-- Runs during parse so the entry pre-hide state (html.hero-js) is in place
     before first paint; without JS nothing is hidden. -->
<script is:inline>
  document.documentElement.classList.add("hero-js");
</script>

<section class="hero-container" aria-label="首页主要内容">
  <div class="quote-screen">
    <!-- Centerpiece: Transparent Quotes Rotator (HOME-02: 4s stay, 1.2s crossfade) -->
    <div
      class="quote-wrapper"
      id="quote-carousel"
      aria-roledescription="carousel"
      aria-label="名人名言轮播"
    >
      <div class="quote-stage">
        {
          quotes.map((item, index) => (
            <div
              class={`quote-slide ${index === 0 ? "is-active" : ""}`}
              data-index={index}
              aria-hidden={index === 0 ? "false" : "true"}
            >
              <blockquote class="quote-text">“{item.quote}”</blockquote>
              <cite class="quote-author">—— {item.author}</cite>
            </div>
          ))
        }
      </div>
    </div>

    <div class="scroll-cue" aria-hidden="true"></div>
  </div>

  <div class="hero-intro">
    <!-- Self Introduction (HOME-03) -->
    <p class="hero-desc">
      <span class="hero-greeting"
        >Hello，我是<span class="hero-name">Aaron</span></span
      >
      <span>一个计算机界的新人，正在探索互联网海洋中</span>
      <span>欢迎访问我的网站</span>
    </p>

    <!-- CTA Action Buttons -->
    <div class="hero-actions">
      <a href="/projects" class="btn btn-primary" aria-label="前往浏览项目作品">
        <span>浏览项目作品</span>
        <svg
          width="16"
          height="16"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2.2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path d="M5 12h14"></path>
          <path d="m12 5 7 7-7 7"></path>
        </svg>
      </a>
      <a href="/posts" class="btn btn-secondary" aria-label="前往阅读文章">
        <span>阅读文章</span>
        <svg
          width="15"
          height="15"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"></path>
          <path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"></path>
        </svg>
      </a>
    </div>
  </div>
</section>

<script>
  function setupQuoteCarousel() {
    const root = document.getElementById("quote-carousel");
    if (!root) return;

    const slides = Array.from(
      root.querySelectorAll<HTMLElement>(".quote-slide"),
    );
    if (slides.length <= 1) return;

    let currentIndex = 0;
    let timer: number | null = null;
    const INTERVAL_MS = 4000; // 用户确认：停留 4 秒

    function goToSlide(nextIndex: number) {
      if (nextIndex === currentIndex) return;

      slides[currentIndex]?.classList.remove("is-active");
      slides[currentIndex]?.setAttribute("aria-hidden", "true");

      currentIndex = (nextIndex + slides.length) % slides.length;

      slides[currentIndex]?.classList.add("is-active");
      slides[currentIndex]?.setAttribute("aria-hidden", "false");
    }

    function startAutoPlay() {
      if (timer !== null) return;
      if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;
      timer = window.setInterval(() => {
        goToSlide(currentIndex + 1);
      }, INTERVAL_MS);
    }

    function stopAutoPlay() {
      if (timer !== null) {
        clearInterval(timer);
        timer = null;
      }
    }

    root.addEventListener("mouseenter", stopAutoPlay);
    root.addEventListener("mouseleave", startAutoPlay);
    root.addEventListener("focusin", stopAutoPlay);
    root.addEventListener("focusout", startAutoPlay);

    startAutoPlay();
  }

  function setupHeroEntry() {
    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;

    const intro = document.querySelector<HTMLElement>(".hero-intro");
    if (!intro) return;

    if (!("IntersectionObserver" in window)) {
      intro.classList.add("is-entered");
      return;
    }

    // Fires once the intro has scrolled ~25% up the viewport, matching the
    // old "entry 30%" pacing; plays once, never reverses on scroll back.
    const observer = new IntersectionObserver(
      (entries) => {
        if (entries.some((entry) => entry.isIntersecting)) {
          intro.classList.add("is-entered");
          observer.disconnect();
        }
      },
      { rootMargin: "0px 0px -25% 0px" },
    );

    // Keyboard users can reach the buttons before scrolling; enter early
    // instead of leaving the focus target invisible.
    intro.addEventListener("focusin", () => {
      intro.classList.add("is-entered");
      observer.disconnect();
    });

    observer.observe(intro);
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", () => {
      setupQuoteCarousel();
      setupHeroEntry();
    });
  } else {
    setupQuoteCarousel();
    setupHeroEntry();
  }
</script>

<style>
  .hero-container {
    width: 100%;
    overflow-x: clip;
    /* 首页名言专用字体：本地托管得意黑 + 楷体/宋体兜底；不动全局 --font-quote，避免扩散到其他页面 */
    --font-quote-home:
      "Smiley Sans Oblique", "Kaiti SC", "STKaiti", "KaiTi", "Songti SC",
      "SimSun", "Source Han Serif SC", "Noto Serif CJK SC", "Georgia", serif;
  }

  .quote-screen {
    position: relative;
    min-height: 100svh;
    display: grid;
    place-items: center;
    padding: 5rem 1.5rem;
    text-align: center;
  }

  .scroll-cue {
    position: absolute;
    bottom: max(1.75rem, env(safe-area-inset-bottom));
    left: 50%;
    translate: -50% 0;
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    pointer-events: none;
  }

  .scroll-cue::before {
    content: "";
    width: 18px;
    height: 12px;
    background: var(--color-accent-forest);
    clip-path: polygon(0 0, 100% 0, 50% 100%);
    animation: cue-float 2.4s ease-in-out infinite;
  }

  @keyframes cue-float {
    0%,
    100% {
      transform: translateY(-4px);
      opacity: 0.5;
    }
    50% {
      transform: translateY(4px);
      opacity: 0.85;
    }
  }

  /* ==========================================================================
     Quote Carousel Component (HOME-02: Transparent, No Box, Large Artistic Text)
     ========================================================================== */
  .quote-wrapper {
    width: 100%;
    max-width: 860px;
    position: relative;
    background: transparent;
    border: none;
    box-shadow: none;
  }

  .quote-stage {
    position: relative;
    min-height: 160px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .quote-slide {
    position: absolute;
    inset: 0;
    width: fit-content;
    max-width: 100%;
    margin-inline: auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    opacity: 0;
    pointer-events: none;
    transform: translateY(4px);
    transition:
      opacity 1.2s ease-in-out,
      transform 1.2s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .quote-slide.is-active {
    opacity: 1;
    pointer-events: auto;
    transform: translateY(0);
    position: relative;
  }

  .quote-text {
    font-family: var(--font-quote-home);
    font-size: clamp(2.1rem, 4.8vw, 3.4rem);
    font-weight: 700;
    line-height: 1.35;
    letter-spacing: 0.02em;
    color: var(--color-text-primary);
    margin: 0 0 0.85rem;
    padding: 0;
    border: none;
    background: transparent;
    font-style: normal;
    text-shadow: 0 1px 2px rgba(242, 239, 229, 0.8);
  }

  .quote-author {
    align-self: flex-end;
    text-align: right;
    font-family: var(--font-sans);
    font-size: clamp(0.95rem, 1.6vw, 1.15rem);
    font-style: normal;
    font-weight: 500;
    color: var(--color-text-muted);
    letter-spacing: 0.04em;
  }

  /* ==========================================================================
     Self Introduction (HOME-03)
     ========================================================================== */
  .hero-intro {
    width: min(calc(100% - 4rem), 880px);
    min-height: 80svh;
    margin: 0 auto;
    padding: 8rem 1.5rem;
    display: grid;
    grid-template-columns: minmax(0, max-content) 1px max-content;
    align-items: center;
    justify-content: center;
    gap: clamp(1.25rem, 3vw, 2rem);
  }

  .hero-intro::before {
    content: "";
    grid-column: 2;
    grid-row: 1;
    width: 1px;
    height: 10rem;
    background: var(--color-border-medium);
  }

  .hero-desc {
    grid-column: 1;
    grid-row: 1;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    font-size: clamp(1.05rem, 2vw, 1.2rem);
    line-height: 1.8;
    color: var(--color-text-secondary);
    max-width: 48ch;
    margin: 0;
    font-weight: 450;
    text-align: right;
  }

  .hero-greeting {
    color: var(--color-text-forest);
  }

  .hero-name {
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: 750;
    line-height: 1.2;
  }

  /* ==========================================================================
     CTA Actions
     ========================================================================== */
  .hero-actions {
    grid-column: 3;
    grid-row: 1;
    display: flex;
    flex-direction: column;
    align-items: stretch;
    justify-content: center;
    gap: 1rem;
  }

  .hero-actions .btn {
    padding: 0.8rem 1.5rem;
    font-size: 0.95rem;
  }

  /* The cue's scroll-away keeps using a scroll timeline where supported;
     elsewhere the static floating cue (cue-float) remains. */
  @supports (animation-timeline: view()) {
    .quote-screen {
      view-timeline: --home-quote block;
    }

    .scroll-cue {
      animation: cue-scroll-away linear both;
      animation-timeline: --home-quote;
      animation-range: exit 0% exit 40%;
    }
  }

  /* Entry animation without scroll timelines: the observer adds .is-entered
     to .hero-intro when it scrolls into view, then this time-based stagger
     plays once. Items pre-hide only when JS is present (html.hero-js set
     inline during parse), so no-JS and reduced-motion users see static
     content. 0.7s per item with a 0.24s step reproduces the old entry-range
     rhythm (35% duration, 12% stagger). */
  @media (prefers-reduced-motion: no-preference) {
    .hero-desc {
      --entry-offset: clamp(-180px, -16vw, -48px);
    }

    .hero-actions {
      --entry-offset: clamp(48px, 16vw, 180px);
    }

    html.hero-js .hero-desc > span,
    html.hero-js .hero-actions > .btn {
      opacity: 0;
    }

    html.hero-js .hero-intro.is-entered .hero-desc > span,
    html.hero-js .hero-intro.is-entered .hero-actions > .btn {
      animation: intro-enter 0.7s var(--ease-out-spring) both;
    }

    html.hero-js .hero-intro.is-entered .hero-desc > span:nth-child(2),
    html.hero-js .hero-intro.is-entered .hero-actions > .btn:nth-child(2) {
      animation-delay: 0.24s;
    }

    html.hero-js .hero-intro.is-entered .hero-desc > span:nth-child(3) {
      animation-delay: 0.48s;
    }

    /* Keyboard focus must never land on an invisible action. */
    html.hero-js .hero-intro:not(.is-entered):focus-within .hero-desc > span,
    html.hero-js
      .hero-intro:not(.is-entered):focus-within
      .hero-actions
      > .btn {
      animation: none;
      opacity: 1;
    }
  }

  @keyframes cue-scroll-away {
    from {
      opacity: 1;
      transform: translateY(0);
    }
    to {
      opacity: 0;
      transform: translateY(var(--cue-scroll-offset, -4rem));
    }
  }

  @keyframes intro-enter {
    from {
      opacity: 0;
      translate: var(--entry-offset) 0;
    }
    to {
      opacity: 1;
      translate: 0 0;
    }
  }

  @media (max-width: 640px) {
    .quote-text {
      font-size: clamp(1.75rem, 6vw, 2.2rem);
    }

    .hero-intro {
      width: calc(100% - 3rem);
      min-height: 80svh;
      grid-template-columns: minmax(0, 1fr);
      align-content: center;
      gap: 2rem;
      padding: 8rem 0 5rem;
    }

    .hero-desc {
      font-size: 1.05rem;
    }

    .hero-intro::before {
      grid-column: 1;
      grid-row: 2;
      width: 100%;
      height: 1px;
    }

    .hero-actions {
      grid-column: 1;
      grid-row: 3;
      gap: 0.85rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .scroll-cue {
      --cue-scroll-offset: 0px;
    }

    .scroll-cue::before {
      animation: none;
    }

    .quote-slide {
      transition: opacity 0.1s ease !important;
      transform: none !important;
    }
  }
</style>
