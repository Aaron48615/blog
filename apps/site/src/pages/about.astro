---
import BaseLayout from "../layouts/BaseLayout.astro";

const skills = [
  { category: "前端框架", items: ["React", "Vue 3", "Astro", "Next.js"] },
  {
    category: "语言与基础",
    items: ["TypeScript", "JavaScript (ESNext)", "HTML5", "CSS3 / Modern CSS"],
  },
  {
    category: "工程与构建",
    items: ["Vite", "pnpm Monorepo", "Prettier", "Git / GitHub Actions"],
  },
  {
    category: "体验与动效",
    items: ["CSS Keyframes", "Responsive Design", "Web Performance", "A11y"],
  },
];

const connectLinks = [
  {
    name: "GitHub",
    href: "https://github.com/Aaron48615",
    handle: "@Aaron48615",
  },
  {
    name: "Email",
    href: "mailto:contact@aaron.dev",
    handle: "contact@aaron.dev",
  },
];
---

<BaseLayout
  title="关于我 | Aaron"
  description="了解 Aaron 的背景、核心技术栈、工程哲学与联系方式。"
>
  <div class="about-page animate-fade-in">
    <header class="page-header">
      <div class="badge animate-fade-in delay-1">
        <span class="badge-dot"></span>
        <span>About & Background</span>
      </div>
      <h1 class="page-title animate-fade-in delay-2">
        探索技术与设计的<span class="text-gradient">交汇边界</span>
      </h1>
    </header>

    <div class="about-content">
      <section class="bio-card glass-card animate-fade-in delay-3">
        <h2>关于 Aaron</h2>
        <p>
          一名热爱 Web
          技术的前端开发者与数字创作者。长期专注于构建交互流畅、性能极致且设计精致的用户界面与中后台系统。
        </p>
        <p>
          崇尚<strong>少即是多</strong>（Less is
          More）的极简哲学，在工程上偏好原生平台特性与标准化工具链，关注渲染性能、动效微交互与代码可维护性。
        </p>
      </section>

      <section class="skills-section animate-fade-in delay-4">
        <h2>技术领域与工具箱</h2>
        <div class="skills-grid">
          {
            skills.map((group) => (
              <div class="skill-group glass-card">
                <h3>{group.category}</h3>
                <div class="skill-tags">
                  {group.items.map((item) => (
                    <span class="skill-pill">{item}</span>
                  ))}
                </div>
              </div>
            ))
          }
        </div>
      </section>

      <section class="connect-section animate-fade-in delay-4">
        <h2>联系与社交</h2>
        <div class="connect-grid">
          {
            connectLinks.map((link) => (
              <a
                href={link.href}
                target={link.href.startsWith("http") ? "_blank" : undefined}
                rel={
                  link.href.startsWith("http")
                    ? "noopener noreferrer"
                    : undefined
                }
                class="connect-card glass-card"
              >
                <div class="connect-info">
                  <span class="connect-name">{link.name}</span>
                  <span class="connect-handle">{link.handle}</span>
                </div>
                <span class="connect-arrow">↗</span>
              </a>
            ))
          }
        </div>
      </section>
    </div>
  </div>
</BaseLayout>

<style>
  .about-page {
    padding: 1rem 0 2rem;
  }

  .page-header {
    margin-bottom: 2.5rem;
  }

  .page-title {
    font-size: clamp(2rem, 4.5vw, 2.8rem);
    margin-top: 1rem;
    margin-bottom: 0.5rem;
    letter-spacing: -0.03em;
  }

  .about-content {
    display: flex;
    flex-direction: column;
    gap: 2.5rem;
  }

  .bio-card h2,
  .skills-section h2,
  .connect-section h2 {
    font-size: 1.35rem;
    margin-bottom: 1.25rem;
    letter-spacing: -0.02em;
  }

  .bio-card p:last-child {
    margin-bottom: 0;
  }

  .skills-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
  }

  @media (min-width: 640px) {
    .skills-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .skill-group {
    padding: 1.25rem 1.5rem;
  }

  .skill-group h3 {
    font-size: 0.95rem;
    color: var(--accent-teal);
    margin-bottom: 0.85rem;
    font-weight: 600;
  }

  .skill-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
  }

  .skill-pill {
    font-size: 0.8rem;
    font-family: var(--font-mono);
    padding: 0.25rem 0.6rem;
    border-radius: var(--radius-sm);
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid var(--border-subtle);
    color: var(--text-secondary);
  }

  .connect-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
  }

  @media (min-width: 640px) {
    .connect-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .connect-card {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1.25rem 1.5rem;
    text-decoration: none;
  }

  .connect-info {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  .connect-name {
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--text-primary);
  }

  .connect-handle {
    font-size: 0.825rem;
    color: var(--text-muted);
    font-family: var(--font-mono);
  }

  .connect-arrow {
    font-size: 1.2rem;
    color: var(--text-muted);
    transition:
      transform 0.2s ease,
      color 0.2s ease;
  }

  .connect-card:hover .connect-arrow {
    transform: translate(2px, -2px);
    color: var(--accent-teal);
  }
</style>
