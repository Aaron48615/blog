---
const featuredProjects = [
  {
    index: "01",
    id: "project-1",
    name: "云枢智慧城市数据平台",
    tagline: "React 19 · 3D 大屏 · 数据可视化",
    description:
      "面向城市运营与指挥中心的智慧城市数据中台，支持指标多维监控、ECharts/Three.js 图表联动与高德地图 API 交互。",
    stack: ["React 19", "TypeScript", "Three.js", "ECharts", "Vite"],
    link: "/projects",
  },
  {
    index: "02",
    id: "project-2",
    name: "拾光集移动商城系统",
    tagline: "Vue 3 · 移动电商 · 大模型赋能",
    description:
      "轻量流畅的移动电商应用，包含商品推荐、购物车与状态持久化交互，并在商品搜索联想中接入 DeepSeek 大模型赋能。",
    stack: ["Vue 3", "Vite", "Pinia", "Vant 4", "DeepSeek AI"],
    link: "/projects",
  },
];
---

<section class="featured-section animate-fade-in delay-3">
  <div class="section-head">
    <div class="head-left">
      <h2 class="section-title">
        精选工程实践 <span class="title-sub">/ Featured Projects</span>
      </h2>
      <p class="section-desc">已纳入个人 Hub 的代表性前端架构与全栈实践。</p>
    </div>
    <a href="/projects" class="all-link">
      <span>查看全部</span>
      <svg
        width="14"
        height="14"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2.5"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <path d="M5 12h14"></path>
        <path d="m12 5 7 7-7 7"></path>
      </svg>
    </a>
  </div>

  <div class="projects-grid">
    {
      featuredProjects.map((project) => (
        <a href={project.link} class="project-card-link">
          <article class="project-card">
            <div class="card-top">
              <span class="project-index">{project.index}</span>
              <span class="project-tagline">{project.tagline}</span>
            </div>

            <h3 class="project-name">
              <span>{project.name}</span>
              <span class="arrow-icon">→</span>
            </h3>

            <p class="project-desc">{project.description}</p>

            <div class="stack-list">
              {project.stack.map((item) => (
                <span class="stack-item">{item}</span>
              ))}
            </div>
          </article>
        </a>
      ))
    }
  </div>
</section>

<style>
  .featured-section {
    padding: 3rem 0 3.5rem;
    border-top: 1px solid var(--color-border-subtle);
  }

  .section-head {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    margin-bottom: 2rem;
    gap: 1rem;
  }

  .section-title {
    margin-bottom: 0.35rem;
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
    font-size: clamp(1.4rem, 3vw, 1.8rem);
    color: var(--color-text-forest);
  }

  .title-sub {
    font-size: 0.95rem;
    font-weight: 500;
    color: var(--color-text-muted);
  }

  .section-desc {
    margin: 0;
    font-size: 0.95rem;
    color: var(--color-text-secondary);
  }

  .all-link {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.875rem;
    font-weight: 650;
    color: var(--color-text-forest);
    padding: 0.4rem 0.85rem;
    border-radius: var(--radius-full);
    background: var(--color-bg-surface);
    border: 1px solid var(--color-border-medium);
    white-space: nowrap;
    transition: all 0.2s var(--ease-out-spring);
    box-shadow: var(--shadow-sm);
  }

  .all-link:hover {
    background: var(--color-bg-surface-elevated);
    border-color: var(--color-accent-forest);
    transform: translateX(2px);
    box-shadow: var(--shadow-md);
  }

  .projects-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
  }

  @media (min-width: 768px) {
    .projects-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .project-card-link {
    display: block;
    height: 100%;
    text-decoration: none;
    color: inherit;
  }

  .project-card {
    height: 100%;
    display: flex;
    flex-direction: column;
    padding: 2rem;
    border-radius: var(--radius-lg);
    background: var(--color-bg-surface);
    border: 1px solid var(--color-border-subtle);
    box-shadow: var(--shadow-sm);
    transition: all 0.3s var(--ease-out-spring);
    position: relative;
  }

  .project-card:hover {
    background: var(--color-bg-surface-elevated);
    border-color: var(--color-border-medium);
    transform: translateY(-4px);
    box-shadow: var(--shadow-card-hover);
  }

  .card-top {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 1rem;
  }

  .project-index {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    font-weight: 700;
    color: var(--color-accent-forest);
    background: var(--color-bg-subtle);
    padding: 0.15rem 0.5rem;
    border-radius: var(--radius-xs);
    border: 1px solid var(--color-border-medium);
  }

  .project-tagline {
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--color-text-muted);
    font-family: var(--font-mono);
  }

  .project-name {
    font-size: 1.35rem;
    font-weight: 750;
    margin: 0 0 0.75rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    color: var(--color-text-primary);
  }

  .arrow-icon {
    font-size: 1.2rem;
    color: var(--color-text-muted);
    transition:
      transform 0.25s var(--ease-out-spring),
      color 0.2s ease;
  }

  .project-card:hover .arrow-icon {
    transform: translateX(5px);
    color: var(--color-accent-forest);
  }

  .project-desc {
    font-size: 0.95rem;
    line-height: 1.7;
    color: var(--color-text-secondary);
    margin: 0 0 1.5rem;
    flex-grow: 1;
  }

  .stack-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    margin-top: auto;
  }

  .stack-item {
    font-size: 0.775rem;
    font-family: var(--font-mono);
    padding: 0.2rem 0.6rem;
    border-radius: var(--radius-xs);
    background: var(--color-bg-subtle);
    color: var(--color-text-forest);
    border: 1px solid var(--color-border-subtle);
    font-weight: 550;
  }

  @media (max-width: 640px) {
    .section-head {
      flex-direction: column;
      align-items: flex-start;
      gap: 1rem;
    }

    .project-card {
      padding: 1.5rem;
    }
  }
</style>
