<script>
  const reduced = matchMedia("(prefers-reduced-motion: reduce)");
  const fine = matchMedia("(hover: hover) and (pointer: fine)");
  const leaves = document.querySelectorAll<HTMLElement>(".foliage-svg");
  // One write per input frame; no permanent animation loop or scroll hijacking.
  let frame = 0;
  let x = 0;
  let y = 0;
  function paint() {
    frame = 0;
    leaves.forEach((leaf, i) => {
      const gain = i === 0 ? 1 : -0.7;
      leaf.style.translate = `${x * 18 * gain}px ${y * 10}px`;
      leaf.style.rotate = `${x * 2 * gain}deg`;
    });
  }
  window.addEventListener(
    "pointermove",
    (event) => {
      if (reduced.matches || !fine.matches) return;
      x = (event.clientX / innerWidth) * 2 - 1;
      y = (event.clientY / innerHeight) * 2 - 1;
      if (!frame) frame = requestAnimationFrame(paint);
    },
    { passive: true },
  );
  function reset() {
    x = 0;
    y = 0;
    if (frame) cancelAnimationFrame(frame);
    paint();
  }
  document.documentElement.addEventListener("pointerleave", reset);
  reduced.addEventListener("change", reset);
  fine.addEventListener("change", reset);

  if (!reduced.matches && "IntersectionObserver" in window) {
    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          entry.target.classList.add("motion-arrived");
          observer.unobserve(entry.target);
        }
      },
      { threshold: 0.08 },
    );
    document
      .querySelectorAll<HTMLElement>(".project-card, .post-card-wrap")
      .forEach((item) => {
        item.classList.add("motion-waiting");
        observer.observe(item);
        item.addEventListener("focusin", () => {
          item.classList.add("motion-arrived");
          observer.unobserve(item);
        });
      });
  }
</script>

<style is:global>
