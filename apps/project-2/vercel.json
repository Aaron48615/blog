{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "pnpm build",
  "outputDirectory": "dist",
  "functions": {
    "api/proxy.ts": { "maxDuration": 20 }
  },
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/proxy?__path=:path*" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
