---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";

const posts = (await getCollection("posts")).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
---

<BaseLayout
  title="文章列表 | Aaron"
  description="Aaron 的技术笔记、项目复盘与开发随笔。"
>
  <div class="posts-layout animate-fade-in">
    <!-- Left Column: Personal Profile Sidebar (Chirpy Simplified Left Bar) -->
    <aside class="profile-sidebar animate-fade-in delay-1">
      <div class="profile-card">
        <!-- POSTS-02: 换头像图片，删除右下角白边绿圆点 -->
        <div class="profile-avatar-wrap">
          <img
            src="/avatar.jpg"
            alt="Aaron"
            class="profile-avatar-img"
            width="64"
            height="64"
            loading="eager"
            decoding="async"
          />
        </div>

        <div class="profile-info">
          <h2 class="profile-name">Aaron</h2>
          <!-- POSTS-04: 定位文案替换 -->
          <p class="profile-role">大四在读 · 前端开发 · 想挣钱买新设备</p>
          <!-- POSTS-05: 移除长简介 -->
        </div>

        <div class="profile-links">
          <a
            href="mailto:aaronluv@126.com"
            class="profile-link"
            title="发送邮件至 aaronluv@126.com"
          >
            <svg
              width="15"
              height="15"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <rect width="20" height="16" x="2" y="4" rx="2"></rect>
              <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path>
            </svg>
            <span>aaronluv@126.com</span>
          </a>

          <a
            href="https://github.com/Aaron48615"
            target="_blank"
            rel="noopener noreferrer"
            class="profile-link"
            title="访问 GitHub 主页"
          >
            <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor">
              <path
                d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0 0 24 12c0-6.63-5.37-12-12-12z"
              ></path>
            </svg>
            <span>GitHub @Aaron48615</span>
          </a>
        </div>

        <!-- POSTS-06: 移除侧栏“浏览项目作品”按钮 -->

        <div class="profile-stats">
          <span class="stats-item"
            >已发布 <strong>{posts.length}</strong> 篇文章</span
          >
        </div>
      </div>
    </aside>

    <!-- Right Column: Articles Feed (Chirpy Simplified Main Area) -->
    <main class="posts-content animate-fade-in delay-2">
      <header class="content-header">
        <h1 class="page-title">
          所有文章 <span class="title-sub">/ Posts</span>
        </h1>
        <!-- POSTS-07: 删掉句号 -->
        <p class="page-subtitle">技术笔记、项目复盘与开发随笔</p>
      </header>

      <div class="posts-list">
        {
          posts.map((post, idx) => (
            <article
              class={`post-card-wrap animate-fade-in delay-${Math.min(idx + 3, 5)}`}
            >
              <a href={`/posts/${post.data.slug}`} class="post-card-link">
                <div class="post-card">
                  <div class="card-meta">
                    <time
                      datetime={post.data.date.toISOString()}
                      class="post-date"
                    >
                      {post.data.date.toLocaleDateString("zh-CN", {
                        year: "numeric",
                        month: "2-digit",
                        day: "2-digit",
                      })}
                    </time>
                    {post.data.tags.length > 0 && (
                      <div class="post-tags">
                        {post.data.tags.map((tag) => (
                          <span class="tag-pill">{tag}</span>
                        ))}
                      </div>
                    )}
                  </div>

                  <h2 class="post-title">
                    <span>{post.data.title}</span>
                    <svg
                      class="title-arrow"
                      width="16"
                      height="16"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2.2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    >
                      <path d="M5 12h14" />
                      <path d="m12 5 7 7-7 7" />
                    </svg>
                  </h2>

                  <p class="post-summary">{post.data.summary}</p>

                  <div class="post-footer-link">
                    <span>阅读全文</span>
                    <span class="link-arrow">&rarr;</span>
                  </div>
                </div>
              </a>
            </article>
          ))
        }

        {
          posts.length === 0 && (
            <div class="empty-state">
              <p>暂无已发布的文章，持续创作中...</p>
            </div>
          )
        }
      </div>
    </main>
  </div>
</BaseLayout>

<style>
  .posts-layout {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.5rem;
    padding: 0.5rem 0 3rem;
  }

  @media (min-width: 860px) {
    .posts-layout {
      grid-template-columns: 290px 1fr;
      gap: 3rem;
      align-items: start;
    }
  }

  /* ==========================================================================
     Profile Sidebar (Left Column - Chirpy Style)
     ========================================================================== */
  .profile-sidebar {
    position: relative;
  }

  @media (min-width: 860px) {
    .profile-sidebar {
      position: sticky;
      top: 5.5rem;
    }
  }

  .profile-card {
    padding: 2rem;
    border-radius: var(--radius-lg);
    background: var(--color-bg-surface);
    border: 1px solid var(--color-border-subtle);
    box-shadow: var(--shadow-sm);
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .profile-avatar-wrap {
    width: 64px;
    height: 64px;
  }

  .profile-avatar-img {
    width: 100%;
    height: 100%;
    border-radius: var(--radius-md);
    object-fit: cover;
    display: block;
    border: 1px solid var(--color-border-medium);
    box-shadow: 0 4px 12px rgba(35, 52, 38, 0.12);
  }

  .profile-info {
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
  }

  .profile-name {
    font-size: 1.45rem;
    font-weight: 750;
    letter-spacing: -0.03em;
    margin: 0;
    color: var(--color-text-primary);
  }

  .profile-role {
    font-size: 0.825rem;
    font-weight: 600;
    color: var(--color-text-forest);
    margin: 0;
    line-height: 1.6;
    letter-spacing: 0.01em;
  }

  .profile-links {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    padding-top: 0.75rem;
    border-top: 1px solid var(--color-border-subtle);
  }

  .profile-link {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-size: 0.825rem;
    color: var(--color-text-secondary);
    font-weight: 500;
    transition: all 0.2s ease;
    word-break: break-all;
  }

  .profile-link:hover {
    color: var(--color-accent-forest);
    transform: translateX(2px);
  }

  .profile-stats {
    padding-top: 0.75rem;
    border-top: 1px solid var(--color-border-subtle);
    font-size: 0.775rem;
    color: var(--color-text-muted);
  }

  .profile-stats strong {
    color: var(--color-text-forest);
    font-weight: 700;
  }

  /* ==========================================================================
     Articles Feed (Right Column)
     ========================================================================== */
  .posts-content {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .content-header {
    margin-bottom: 1rem;
  }

  .page-title {
    font-size: clamp(2rem, 4vw, 2.5rem);
    letter-spacing: -0.035em;
    margin-bottom: 0.5rem;
    color: var(--color-text-primary);
  }

  .title-sub {
    font-size: 1.25rem;
    font-weight: 500;
    color: var(--color-text-muted);
  }

  .page-subtitle {
    font-size: 1rem;
    color: var(--color-text-secondary);
    margin: 0;
  }

  .posts-list {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .post-card-wrap {
    display: block;
  }

  .post-card-link {
    display: block;
    text-decoration: none;
    color: inherit;
    border-radius: var(--radius-md);
  }

  .post-card {
    padding: 1.75rem 2rem;
    border-radius: var(--radius-md);
    background: var(--color-bg-surface);
    border: 1px solid var(--color-border-subtle);
    box-shadow: var(--shadow-sm);
    transition: all 0.3s var(--ease-out-spring);
    position: relative;
  }

  .post-card:hover {
    background: var(--color-bg-surface-elevated);
    border-color: var(--color-border-medium);
    transform: translateY(-3px);
    box-shadow: var(--shadow-card-hover);
  }

  .card-meta {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    margin-bottom: 0.75rem;
    font-size: 0.825rem;
  }

  .post-date {
    font-family: var(--font-mono);
    color: var(--color-text-muted);
    font-size: 0.8rem;
    font-weight: 550;
  }

  .post-tags {
    display: flex;
    gap: 0.35rem;
  }

  .tag-pill {
    font-size: 0.725rem;
    font-family: var(--font-mono);
    padding: 0.15rem 0.55rem;
    border-radius: var(--radius-full);
    background: var(--color-bg-subtle);
    border: 1px solid var(--color-border-subtle);
    color: var(--color-text-forest);
    font-weight: 600;
  }

  .post-title {
    font-size: clamp(1.2rem, 2.8vw, 1.45rem);
    font-weight: 750;
    letter-spacing: -0.02em;
    margin: 0 0 0.65rem;
    color: var(--color-text-primary);
    display: flex;
    align-items: center;
    justify-content: space-between;
    transition: color 0.2s ease;
  }

  .title-arrow {
    color: var(--color-text-muted);
    opacity: 0;
    transform: translateX(-4px);
    transition: all 0.25s var(--ease-out-spring);
    flex-shrink: 0;
  }

  .post-card:hover .post-title {
    color: var(--color-text-forest);
  }

  .post-card:hover .title-arrow {
    opacity: 1;
    transform: translateX(0);
    color: var(--color-accent-forest);
  }

  .post-summary {
    font-size: 0.95rem;
    line-height: 1.7;
    color: var(--color-text-secondary);
    margin: 0 0 1.25rem;
    max-width: 68ch;
  }

  .post-footer-link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.875rem;
    font-weight: 650;
    color: var(--color-text-forest);
    transition: gap 0.2s ease;
  }

  .post-card:hover .post-footer-link {
    gap: 0.65rem;
  }

  .empty-state {
    padding: 3.5rem 1rem;
    text-align: center;
    border-radius: var(--radius-md);
    background: var(--color-bg-surface);
    border: 1px dashed var(--color-border-medium);
    color: var(--color-text-muted);
  }

  @media (max-width: 640px) {
    .profile-card {
      padding: 1.5rem;
    }

    .post-card {
      padding: 1.35rem;
    }
  }
</style>
