  }
  .post-card-link:hover .post-title span,
  .post-card-link:focus-visible .post-title span {
    background-size: 100% 1px;
  }
  @media (prefers-reduced-motion: no-preference) {
    .site-header-pill {
      animation: header-arrive 0.65s var(--motion-ease) both;
    }
    .project-card.motion-waiting {
      opacity: 0;
      translate: 0 28px;
      scale: 0.985;
      transition:
        opacity 0.65s ease,
        translate 0.85s var(--motion-ease),
        scale 0.85s var(--motion-ease),
        background 0.2s ease;
    }
    .post-card-wrap.motion-waiting {
      opacity: 0;
      translate: 24px 0;
      transition:
        opacity 0.5s ease,
        translate 0.7s var(--motion-ease);
    }
    .motion-waiting.motion-arrived,
    .motion-waiting:focus-within {
      opacity: 1;
      translate: 0 0;
      scale: 1;
    }
  }
  @keyframes header-arrive {
    from {
      opacity: 0;
      translate: 0 -12px;
    }
    to {
      opacity: 1;
      translate: 0 0;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .foliage-svg {
      translate: none !important;
      rotate: none !important;
    }
    .motion-waiting {
      opacity: 1;
      translate: none;
      scale: none;
    }
