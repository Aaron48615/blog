# Public client configuration. VITE_* values are embedded in the bundle.
VITE_APP_URL=/api

# Server-only: configure in Vercel, never add a VITE_ prefix or commit a real key.
DEEPSEEK_API_KEY=
DEEPSEEK_API_BASE=https://api.deepseek.com/v1
# Code fallback is deepseek-chat (legacy); use a currently supported model.
DEEPSEEK_API_MODEL=deepseek-v4-flash
AI_RATE_LIMIT_PER_MINUTE=10
AI_RATE_LIMIT_PER_HOUR=50
